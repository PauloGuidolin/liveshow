<section id="contacto" class="py-24 bg-zinc-950">
  <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-16">
    
    <div class="space-y-8">
      <div>
        <h2 class="text-5xl font-black text-white mb-6 uppercase tracking-tighter">
          Llevamos el <span class="text-fuchsia-500">Show</span> a tu evento
        </h2>
        <p class="text-zinc-400 text-lg">
          Completá el formulario y nuestro equipo de producción se contactará con vos para coordinar todos los detalles técnicos y artísticos.
        </p>
      </div>

      <div class="space-y-4">
        <div class="flex items-center gap-4 text-white">
          <div class="w-12 h-12 rounded-full bg-fuchsia-500/10 flex items-center justify-center text-fuchsia-500">
            📍
          </div>
          <div>
            <p class="text-xs uppercase tracking-widest text-zinc-500 font-bold">Oficina Central</p>
            <p class="font-medium">Palermo, Ciudad de Buenos Aires</p>
          </div>
        </div>
        <div class="flex items-center gap-4 text-white">
          <div class="w-12 h-12 rounded-full bg-fuchsia-500/10 flex items-center justify-center text-fuchsia-500">
            📧
          </div>
          <div>
            <p class="text-xs uppercase tracking-widest text-zinc-500 font-bold">Email</p>
            <p class="font-medium">produccion@liveshow.com</p>
          </div>
        </div>
      </div>
    </div>

    <form class="bg-zinc-900 p-8 rounded-3xl border border-white/5 space-y-4 shadow-2xl">
      <div class="grid md:grid-cols-2 gap-4">
        <input type="text" placeholder="Nombre completo" class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-fuchsia-500 outline-none transition-all" />
        <input type="tel" placeholder="WhatsApp" class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-fuchsia-500 outline-none transition-all" />
      </div>
      <select class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-zinc-400 focus:border-fuchsia-500 outline-none transition-all">
        <option>Tipo de Evento</option>
        <option>Boda / Quince</option>
        <option>Evento Corporativo</option>
        <option>Festival / Show Público</option>
      </select>
      <textarea rows="4" placeholder="Detalles (Fecha, cantidad de personas, etc.)" class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-fuchsia-500 outline-none transition-all"></textarea>
      <button class="w-full bg-fuchsia-600 hover:bg-fuchsia-500 text-white font-black py-4 rounded-xl shadow-lg shadow-fuchsia-600/20 transition-all uppercase tracking-widest">
        Enviar Solicitud
      </button>
    </form>
  </div>
</section>