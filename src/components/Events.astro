---
const shows = [
  { title: "Noche de Gala", date: "25 MAR", img: "https://images.unsplash.com/photo-1514525253344-724745723fb4?q=80&w=500" },
  { title: "Show Pop Latino", date: "02 ABR", img: "https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=500" },
  { title: "Tributo Rock", date: "15 ABR", img: "https://images.unsplash.com/photo-1459749411177-042180ce6742?q=80&w=500" },
];
---
<section id="eventos" class="py-24 bg-black text-white">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-4xl font-black mb-12 border-l-8 border-fuchsia-600 pl-6">PRÓXIMOS EVENTOS</h2>
    <div class="grid md:grid-cols-3 gap-8">
      {shows.map(show => (
        <div class="group relative overflow-hidden rounded-2xl bg-zinc-900 border border-white/5 shadow-2xl">
          <img src={show.img} class="w-full h-80 object-cover group-hover:scale-110 transition-transform duration-500 opacity-70" alt={show.title} />
          <div class="absolute inset-0 bg-gradient-to-t from-black px-6 pb-6 flex flex-col justify-end">
            <span class="text-fuchsia-500 font-bold mb-1">{show.date}</span>
            <h3 class="text-2xl font-bold mb-4">{show.title}</h3>
            <button class="bg-white text-black text-xs font-black py-2 rounded-lg hover:bg-fuchsia-500 hover:text-white transition-colors">RESERVAR LUGAR</button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>