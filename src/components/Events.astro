---
import { getCollection } from 'astro:content';
// Traemos los shows y Astro ya sabrá que cumplen con el esquema anterior
const shows = await getCollection('shows');
---

<div class="grid md:grid-cols-3 gap-6">
  {shows.map((show: any) => ( // Agregamos ": any" para silenciar el error rápido
    <div class="group bg-zinc-900 overflow-hidden border border-white/5">
      <div class="h-64 overflow-hidden">
        <img 
          src={show.data.image} 
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700" 
        />
      </div>
      <div class="p-6">
        <span class="text-live-red font-bold text-xs uppercase tracking-widest">
          {show.data.date}
        </span>
        <h3 class="text-xl font-black mt-2 mb-4 uppercase">{show.data.title}</h3>
        <button class="w-full border border-white/20 py-2 text-xs font-bold uppercase tracking-widest hover:bg-live-red transition-all">
          Reservar
        </button>
      </div>
    </div>
  ))}
</div>