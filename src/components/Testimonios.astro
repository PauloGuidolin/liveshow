---
const testimonials = [
  {
    name: "Marcos Galperín",
    role: "Evento Corporativo",
    text: "La puntualidad y el despliegue técnico fueron impecables. El show de luces transformó el salón por completo.",
    avatar: "👤"
  },
  {
    name: "Romina Sosa",
    role: "Boda",
    text: "Increíble la energía de la banda. No hubo un solo invitado que se quedara sentado. ¡Gracias por hacer nuestra noche mágica!",
    avatar: "👤"
  },
  {
    name: "Lucas Benítez",
    role: "Fiesta de 15",
    text: "Contratamos el pack premium con efectos especiales y valió cada centavo. La coordinación fue perfecta de principio a fin.",
    avatar: "👤"
  }
];
---

<section class="py-24 bg-zinc-950 relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-fuchsia-600/10 rounded-full blur-[120px]"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-purple-600/10 rounded-full blur-[120px]"></div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <div class="text-center mb-16">
      <h2 class="text-fuchsia-500 font-bold tracking-[0.2em] uppercase text-sm mb-4">Experiencias Reales</h2>
      <p class="text-4xl md:text-5xl font-black text-white italic tracking-tighter">LO QUE DICEN NUESTROS CLIENTES</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map((item) => (
        <div class="bg-zinc-900/50 backdrop-blur-sm p-8 rounded-3xl border border-white/5 hover:border-fuchsia-500/50 transition-all duration-500 group">
          <div class="text-fuchsia-500 text-5xl mb-6 group-hover:scale-110 transition-transform inline-block">“</div>
          <p class="text-zinc-300 mb-8 italic leading-relaxed">
            {item.text}
          </p>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-zinc-800 flex items-center justify-center text-2xl">
              {item.avatar}
            </div>
            <div>
              <p class="text-white font-bold text-sm uppercase tracking-wider">{item.name}</p>
              <p class="text-fuchsia-500 text-xs font-medium">{item.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>